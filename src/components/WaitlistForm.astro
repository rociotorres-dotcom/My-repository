---
interface Props {
  instanceId: string;
}

const { instanceId } = Astro.props;
---

<div class="waitlist-form" data-waitlist-form data-instance-id={instanceId}>
	<form class="waitlist-form__form">
		<div class="waitlist-form__row">
			<label class="waitlist-form__field">
				<span>First name <em class="waitlist-form__req" aria-hidden="true">*</em></span>
				<input type="text" name="firstName" required autocomplete="given-name" />
			</label>
			<label class="waitlist-form__field">
				<span>Email <em class="waitlist-form__req" aria-hidden="true">*</em></span>
				<input type="email" name="email" required autocomplete="email" />
			</label>
		</div>
		<label class="waitlist-form__field">
			<span
				>What's the one thing about your home that's hardest to keep track of
				<em class="waitlist-form__optional">optional</em></span
			>
			<textarea name="topProblem" rows="3"></textarea>
		</label>
		<button type="submit">
			<span>Join the waitlist</span>
			<span class="waitlist-form__arrow" aria-hidden="true">→</span>
		</button>
	</form>
	<div class="waitlist-form__success" hidden>
		<span class="waitlist-form__success-mark" aria-hidden="true">✓</span>
		<!--
			TODO: this is preview/demo copy, not the final copy. Submissions are NOT
			persisted anywhere yet (analytics.ts is a no-op — see P-004/P-117). Revert
			to "You're on the list. We'll be in touch." only once analytics.ts actually
			saves the signup somewhere.
		-->
		<p>You're previewing Gnome early. The real thing comes next.</p>
	</div>
</div>

<style>
	.waitlist-form {
		width: 100%;
		max-width: 26rem;
	}

	.waitlist-form__form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
	}

	.waitlist-form__row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	@media (max-width: 31.25rem) {
		.waitlist-form__row {
			grid-template-columns: 1fr;
		}
	}

	.waitlist-form__field {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.waitlist-form__field > span {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--wo-muted);
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.waitlist-form__req {
		color: var(--wo-accent-ink);
		font-style: normal;
	}

	.waitlist-form__optional {
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-style: normal;
		color: var(--wo-accent-ink);
		background: color-mix(in srgb, var(--color-accent-strong) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-accent-strong) 35%, transparent);
		padding: 0.125rem 0.5rem;
		border-radius: 3px;
	}

	.waitlist-form__field input,
	.waitlist-form__field textarea {
		background: var(--wo-sunken);
		border: 1px solid var(--wo-border);
		border-radius: var(--radius-control);
		color: var(--color-text-body);
		font-family: var(--font-body);
		font-size: 0.875rem;
		padding: 0.7rem 0.9rem;
		outline: none;
		width: 100%;
		transition: border-color 0.2s, box-shadow 0.2s;
	}

	.waitlist-form__field input::placeholder,
	.waitlist-form__field textarea::placeholder {
		color: var(--wo-muted);
	}

	.waitlist-form__field input:focus,
	.waitlist-form__field textarea:focus {
		border-color: var(--color-accent-strong);
		border-width: 1.5px;
		box-shadow: none;
	}

	.waitlist-form__field textarea {
		resize: vertical;
		min-height: 5rem;
	}

	.waitlist-form__form button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		background: var(--color-accent-strong);
		color: var(--wo-on-accent);
		border: none;
		border-radius: var(--radius-control);
		min-height: 44px;
		font-family: var(--font-body);
		font-size: 0.9375rem;
		font-weight: 600;
		padding: 0.6rem 1.5rem;
		cursor: pointer;
		align-self: flex-start;
		transition: background 0.2s;
	}

	.waitlist-form__form button:hover {
		background: var(--wo-accent-hover);
	}

	.waitlist-form__arrow {
		font-size: 1rem;
		transition: transform 0.2s;
	}

	.waitlist-form__form button:hover .waitlist-form__arrow {
		transform: translateX(3px);
	}

	/* Fern, not orange: a confirmation is a positive-state message, and orange stays
	   reserved for the next action, not a message about a past one. */
	.waitlist-form__success {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem 1.25rem;
		background: var(--color-surface-alt);
		border-left: 3px solid var(--wo-fern);
		border-radius: var(--radius-control);
		font-size: 0.95rem;
	}

	.waitlist-form__success-mark {
		color: var(--wo-fern);
		font-size: 1.15rem;
		font-weight: 700;
	}
</style>

<script>
	import { trackWaitlistSignup } from '../lib/analytics';

	// TODO P-004 / P-117: no localStorage persistence on purpose — this is a preview/demo
	// page being compared internally, not a live waitlist. Persisting "already signed up"
	// across visits would mean anyone who submits once (a reviewer, a manager) can never
	// see the form again. Bring persistence back once there's a real backend that actually
	// saves signups — at that point it stops being a UX inconvenience and starts being correct.
	const EVENT_NAME = 'waitlist:signed_up';

	function getUtmSource(): string {
		return new URLSearchParams(window.location.search).get('utm_source') ?? '';
	}

	function showSuccess(root: ParentNode) {
		const form = root.querySelector<HTMLFormElement>('.waitlist-form__form');
		const success = root.querySelector<HTMLElement>('.waitlist-form__success');
		if (form) form.hidden = true;
		if (success) success.hidden = false;
	}

	document.querySelectorAll<HTMLElement>('[data-waitlist-form]').forEach((root) => {
		const form = root.querySelector<HTMLFormElement>('.waitlist-form__form');
		form?.addEventListener('submit', (event) => {
			event.preventDefault();
			const data = new FormData(form);

			trackWaitlistSignup({
				firstName: String(data.get('firstName') ?? '').trim(),
				email: String(data.get('email') ?? '').trim(),
				topProblem: String(data.get('topProblem') ?? '').trim(),
				source: getUtmSource(),
			});

			document.dispatchEvent(new CustomEvent(EVENT_NAME));
		});
	});

	document.addEventListener(EVENT_NAME, () => {
		document.querySelectorAll('[data-waitlist-form]').forEach(showSuccess);
	});
</script>

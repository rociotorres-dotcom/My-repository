---
const feedbackTypes = ['Suggestion', 'Bug', 'Question'];
---

<div class="feedback-widget" data-feedback-widget>
	<button
		type="button"
		class="feedback-widget__trigger"
		aria-haspopup="dialog"
		aria-expanded="false"
	>
		<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
			<path
				d="M14 1H2C1.45 1 1 1.45 1 2v9c0 .55.45 1 1 1h9l3 3V2c0-.55-.45-1-1-1z"
				fill="currentColor"
			></path>
		</svg>
		<span>Feedback</span>
	</button>

	<div class="feedback-widget__panel" role="dialog" aria-label="Send feedback" hidden>
		<div class="feedback-widget__header">
			<p class="feedback-widget__title">Send feedback</p>
			<button type="button" class="feedback-widget__close" aria-label="Close feedback panel">✕</button>
		</div>

		<form class="feedback-widget__form">
			<div class="feedback-widget__field">
				<span class="feedback-widget__label">Type</span>
				<div class="feedback-widget__type-row">
					{
						feedbackTypes.map((type, i) => (
							<label class="feedback-widget__type-option">
								<input type="radio" name="type" value={type} checked={i === 0} />
								<span>{type}</span>
							</label>
						))
					}
				</div>
			</div>

			<label class="feedback-widget__field">
				<span class="feedback-widget__label">Email <em>optional</em></span>
				<input type="email" name="email" autocomplete="email" />
			</label>

			<label class="feedback-widget__field">
				<span class="feedback-widget__label">Message <em class="feedback-widget__req">*</em></span>
				<textarea name="message" required rows="4"></textarea>
			</label>

			<button type="submit" class="feedback-widget__submit">Send</button>
		</form>

		<div class="feedback-widget__confirmation" hidden>
			<span class="feedback-widget__success-mark" aria-hidden="true">✓</span>
			<p>Got it — thanks for the feedback.</p>
		</div>
	</div>
</div>

<style>
	.feedback-widget {
		position: fixed;
		right: 1.5rem;
		bottom: 1.5rem;
		z-index: 200;
	}

	/* Secondary/bordered on purpose, same reasoning as .nav-cta — orange stays reserved
	   for the waitlist submit buttons, the actual primary action on this page. */
	.feedback-widget__trigger {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: var(--color-surface-alt);
		border: 1.5px solid var(--wo-border);
		color: var(--color-text-body);
		border-radius: var(--radius-control);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: calc(0.65rem - 1.5px) calc(1rem - 1.5px);
		cursor: pointer;
		box-shadow: var(--shadow-shell);
		transition: border-color 0.2s, color 0.2s;
	}

	.feedback-widget__trigger:hover {
		border-color: var(--color-accent-strong);
		color: var(--wo-accent-ink);
	}

	.feedback-widget__panel {
		position: absolute;
		bottom: calc(100% + 0.75rem);
		right: 0;
		width: 20rem;
		background: var(--color-surface-alt);
		border: 1px solid var(--wo-border);
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-shell);
		overflow: hidden;
	}

	.feedback-widget__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 1.1rem 0.75rem;
		border-bottom: 1px solid var(--wo-border);
	}

	.feedback-widget__title {
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.feedback-widget__close {
		background: none;
		border: none;
		color: var(--color-text-body);
		opacity: 0.7;
		font-size: 0.875rem;
		cursor: pointer;
		padding: 0.15rem 0.25rem;
		line-height: 1;
	}

	.feedback-widget__close:hover {
		opacity: 1;
	}

	.feedback-widget__form {
		padding: 1rem 1.1rem 1.1rem;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.feedback-widget__field {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.feedback-widget__label {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--wo-muted);
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.feedback-widget__label em {
		font-style: normal;
	}

	.feedback-widget__req {
		color: var(--wo-accent-ink);
	}

	.feedback-widget__type-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.feedback-widget__type-option input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.feedback-widget__type-option span {
		display: inline-block;
		font-size: 0.6875rem;
		font-weight: 600;
		color: var(--wo-muted);
		padding: 0.35rem 0.65rem;
		border: 1px solid var(--wo-border);
		border-radius: var(--radius-pill);
		cursor: pointer;
		white-space: nowrap;
		transition: 0.15s;
	}

	.feedback-widget__type-option input:checked + span {
		background: color-mix(in srgb, var(--color-accent-strong) 12%, transparent);
		border-color: var(--color-accent-strong);
		color: var(--wo-accent-ink);
		opacity: 1;
	}

	.feedback-widget__field input,
	.feedback-widget__field textarea {
		background: var(--wo-sunken);
		border: 1px solid var(--wo-border);
		border-radius: var(--radius-control);
		color: var(--color-text-body);
		padding: 0.55rem 0.75rem;
		font-family: var(--font-body);
		font-size: 0.8125rem;
		outline: none;
		transition: border-color 0.2s;
	}

	.feedback-widget__field input:focus,
	.feedback-widget__field textarea:focus {
		border-color: var(--color-accent-strong);
		border-width: 1.5px;
	}

	.feedback-widget__submit {
		background: var(--color-accent-strong);
		border: none;
		border-radius: var(--radius-control);
		color: var(--wo-on-accent);
		font-family: var(--font-body);
		font-size: 0.875rem;
		font-weight: 600;
		min-height: 44px;
		padding: 0.65rem;
		cursor: pointer;
		align-self: stretch;
		transition: background 0.2s;
	}

	.feedback-widget__submit:hover {
		background: var(--wo-accent-hover);
	}

	.feedback-widget__confirmation {
		padding: 1.5rem 1.1rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.875rem;
	}

	.feedback-widget__success-mark {
		color: var(--wo-fern);
		font-size: 1.25rem;
		font-weight: 700;
	}
</style>

<script>
	import { submitFeedback } from '../lib/feedback';

	const widget = document.querySelector<HTMLElement>('[data-feedback-widget]');
	if (widget) {
		const trigger = widget.querySelector<HTMLButtonElement>('.feedback-widget__trigger');
		const panel = widget.querySelector<HTMLElement>('.feedback-widget__panel');
		const form = widget.querySelector<HTMLFormElement>('.feedback-widget__form');
		const confirmation = widget.querySelector<HTMLElement>('.feedback-widget__confirmation');
		const closeButton = widget.querySelector<HTMLButtonElement>('.feedback-widget__close');

		function openPanel() {
			panel?.removeAttribute('hidden');
			trigger?.setAttribute('aria-expanded', 'true');
		}

		function closePanel() {
			panel?.setAttribute('hidden', '');
			trigger?.setAttribute('aria-expanded', 'false');
			if (form) form.hidden = false;
			if (confirmation) confirmation.hidden = true;
			form?.reset();
		}

		trigger?.addEventListener('click', () => {
			if (panel?.hasAttribute('hidden')) openPanel();
			else closePanel();
		});

		closeButton?.addEventListener('click', closePanel);

		form?.addEventListener('submit', (event) => {
			event.preventDefault();
			const data = new FormData(form);

			submitFeedback({
				type: String(data.get('type') ?? 'Suggestion') as 'Suggestion' | 'Bug' | 'Question',
				email: String(data.get('email') ?? '').trim(),
				message: String(data.get('message') ?? '').trim(),
				breadcrumb: window.location.href,
			});

			form.hidden = true;
			if (confirmation) confirmation.hidden = false;
			window.setTimeout(closePanel, 2500);
		});
	}
</script>

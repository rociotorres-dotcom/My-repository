---
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Gnome — Early Access',
  description = 'Gnome is the asset-optimization platform that turns how well you keep your home into what it’s worth. Join early access.',
} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- TODO: remove at real public launch — this page is internal-preview only for now -->
		<meta name="robots" content="noindex,nofollow" />

		<!-- Open Graph — no domain/URL hardcoded here; P-002 not confirmed yet -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Gnome" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Warm Operator type system — see context/gnome-warm-operator-design-system.md -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&family=DM+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>

		<script is:inline>
			// Applies the stored layout variant before first paint, mobile-aware, to avoid
			// a flash of the wrong layout. Mirrors the runtime logic in VariantSwitcher.astro.
			(function () {
				var MOBILE_BP = 600;
				try {
					var stored = localStorage.getItem('gnome:landing-variant') || 'center-stage';
					var effective = window.innerWidth <= MOBILE_BP ? 'center-stage' : stored;
					document.documentElement.setAttribute('data-variant', effective);
				} catch (e) {
					document.documentElement.setAttribute('data-variant', 'center-stage');
				}
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}

	[hidden] {
		display: none !important;
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}

	body {
		background: var(--color-bg);
		color: var(--color-text-body);
		font-family: var(--font-body);
		line-height: 1.5;
		-webkit-font-smoothing: antialiased;
		min-height: 100vh;
		position: relative;
		overflow-x: hidden;
	}

	/*
		Warm Operator type rule: Hanken Grotesk (sans) bold carries every headline.
		Instrument Serif (--font-display) is reserved for ONE italic aside per view —
		see the <em> emphasis line inside .subtitle — never for headings themselves.
	*/
	h1,
	h2,
	h3 {
		font-family: var(--font-body);
		font-weight: 700;
		letter-spacing: var(--wo-track-display);
		line-height: 1.05;
		margin: 0;
	}

	p {
		margin: 0;
	}

	a {
		color: inherit;
	}

	button {
		font-family: var(--font-body);
	}
</style>

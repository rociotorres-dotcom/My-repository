---
// Single landing page with a layout-variant switcher (Center Stage / Side by Side /
// Split), structurally identical to po-traction-engine.vercel.app/waitlist — same
// class structure, spacing, and breakpoints, with our own tokens (colors/fonts) and
// approved copy swapped in. Only the hero changes per variant; features, bottom CTA,
// and footer are constant, exactly as in the reference.
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import FeedbackWidget from '../components/FeedbackWidget.astro';
import VariantSwitcher from '../components/VariantSwitcher.astro';

const year = new Date().getFullYear();
---

<BaseLayout>
	<nav class="sticky-nav">
		<div class="nav-logo">
			<!-- TODO P-114: typographic wordmark, provisional — replace with the real logo when Together Agency delivers it -->
			<span class="nav-logo-label">Gnome</span>
		</div>
		<div class="nav-switcher">
			<VariantSwitcher />
		</div>
		<a href="#waitlist-hero" class="nav-cta">Join the waitlist <span aria-hidden="true">→</span></a>
	</nav>

	<div class="page">
		<main class="hero">
			<div class="hero-inner">
				<div class="hero-copy">
					<p class="eyebrow">Early access</p>
					<h1 class="headline">Managed like an investment.<br />Easy as a companion.</h1>
					<p class="subtitle">
						Gnome turns every receipt, repair, and project into a record that protects your
						basis, backs your claims, and moves your value.<br />
						<em
							>Financial-grade tracking, delivered with the ease of a capable friend who happens
							to know houses and money.</em
						>
					</p>
				</div>

				<div class="hero-form" id="waitlist-hero">
					<p class="form-eyebrow">Join the waitlist</p>
					<p class="urgency-signal">Early access · By invitation, starting with our founder circle.</p>
					<WaitlistForm instanceId="hero" />
				</div>
			</div>
		</main>
	</div>

	<section class="features">
		<p class="section-eyebrow">What you'll get</p>
		<div class="features-grid">
			<div class="feature-card">
				<span class="feat-num">01</span>
				<h3 class="feat-title">See it all, finally</h3>
				<p class="feat-body">
					Paint, equipment, documents, and cost basis — the whole home, legible for the first
					time.
				</p>
			</div>

			<div class="feature-card">
				<span class="feat-num">02</span>
				<h3 class="feat-title">See it coming</h3>
				<p class="feat-body">
					Maintenance flagged before it's a liability. Improvements weighed by what they'll
					actually return.
				</p>
			</div>

			<div class="feature-card">
				<span class="feat-num">03</span>
				<h3 class="feat-title">Built to be inherited</h3>
				<p class="feat-body">
					An insurance-ready report, a buyer-ready history, a record a new contractor — or an
					heir — can pick up without starting blind.
				</p>
			</div>
		</div>
	</section>

	<section class="bottom-cta" id="waitlist">
		<div class="bottom-cta-inner">
			<div class="bottom-cta-copy">
				<p class="bottom-eyebrow">Secure your spot</p>
				<h2 class="bottom-headline">Command, not chores.</h2>
				<p class="bottom-sub">Reserve your spot. Gnome does the watching; every decision stays yours.</p>
			</div>
			<div class="bottom-form" id="waitlist-bottom">
				<WaitlistForm instanceId="bottom" />
			</div>
		</div>
	</section>

	<footer class="site-footer">
		<!-- TODO P-114: same provisional wordmark as the nav -->
		<span>Gnome · {year}</span>
		<span class="sep">·</span>
		<span>TractionLab · Designli</span>
	</footer>

	<FeedbackWidget />
</BaseLayout>

<style>
	/* Left accent bar — fixed, full height. Matches the reference's slim brand bar. */
	:global(body)::before {
		content: '';
		position: fixed;
		top: 0;
		left: 0;
		width: 5px;
		height: 100vh;
		background: var(--color-accent-strong);
		z-index: 100;
	}

	.sticky-nav {
		position: fixed;
		top: 0;
		left: 5px;
		right: 0;
		height: 3.25rem;
		z-index: 200;
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1rem;
		padding: 0 1.25rem;
		background: color-mix(in srgb, var(--color-bg) 92%, transparent);
		backdrop-filter: blur(14px);
		border-bottom: 1px solid color-mix(in srgb, var(--color-text-body) 8%, transparent);
	}

	.nav-logo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav-logo-label {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1.1rem;
	}

	.nav-switcher {
		display: flex;
		justify-content: center;
	}

	.nav-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		background: var(--color-accent-strong);
		color: var(--color-bg);
		text-decoration: none;
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 0.55rem 0.9rem;
		border-radius: 5px;
		white-space: nowrap;
		transition: filter 0.2s, transform 0.15s;
	}

	.nav-cta:hover {
		filter: brightness(1.08);
		transform: translateY(-1px);
	}

	@media (max-width: 37.5rem) {
		.sticky-nav {
			grid-template-columns: auto 1fr;
		}

		.nav-cta {
			padding: 0.45rem 0.7rem;
		}
	}

	.page {
		padding-top: 3.25rem;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-left: calc(5px + 1.5rem);
		padding-right: 1.5rem;
	}

	.hero {
		flex: 1;
		width: 100%;
		max-width: 53.75rem;
		display: flex;
		align-items: center;
		padding: 4.5rem 0 3.75rem;
	}

	.hero-inner {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	@media (min-width: 48rem) {
		.hero-inner {
			flex-direction: row;
			align-items: flex-start;
			gap: 4rem;
		}

		.hero-copy {
			flex: 1;
			min-width: 0;
		}

		.hero-form {
			flex: 0 0 21.25rem;
			padding-top: 0.5rem;
		}
	}

	.eyebrow {
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.35em;
		text-transform: uppercase;
		color: var(--color-accent-strong);
		margin-bottom: 1.75rem;
	}

	.headline {
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 6vw, 4.5rem);
		font-weight: 400;
		line-height: 1;
		margin-bottom: 2.25rem;
	}

	.subtitle {
		font-family: var(--font-display);
		font-size: clamp(1.0625rem, 2vw, 1.3125rem);
		line-height: 1.65;
		opacity: 0.85;
		margin-bottom: 1.5rem;
	}

	.subtitle em {
		font-style: italic;
		color: var(--color-accent-strong);
	}

	.form-eyebrow {
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--color-accent-strong);
		margin-bottom: 0.5rem;
	}

	.urgency-signal {
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		color: var(--color-accent-strong);
		background: color-mix(in srgb, var(--color-accent-strong) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-accent-strong) 35%, transparent);
		border-radius: 3px;
		padding: 0.25rem 0.6rem;
		display: inline-block;
		margin-bottom: 1.25rem;
	}

	/* Center Stage */
	:global([data-variant='center-stage']) .page {
		align-items: center;
	}

	:global([data-variant='center-stage']) .hero {
		max-width: 40rem;
		text-align: center;
	}

	:global([data-variant='center-stage']) .hero-inner {
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
	}

	:global([data-variant='center-stage']) .headline {
		font-size: clamp(2.25rem, 5vw, 4rem);
	}

	:global([data-variant='center-stage']) .hero-form {
		width: 100%;
		max-width: 30rem;
		flex: 0 0 auto;
		padding-top: 0;
		text-align: left;
	}

	/* Split */
	:global([data-variant='split']) .page {
		flex-direction: row;
		align-items: stretch;
		max-width: none;
		padding: 0;
		min-height: 100vh;
	}

	:global([data-variant='split']) .hero {
		max-width: none;
		width: 100%;
		padding: 0;
		display: flex;
		align-items: stretch;
	}

	:global([data-variant='split']) .hero-inner {
		flex-direction: row;
		align-items: stretch;
		gap: 0;
		width: 100%;
		min-height: calc(100vh - 3.25rem);
	}

	:global([data-variant='split']) .hero-copy {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 5rem 3.75rem 5rem calc(5px + 3.75rem);
		background: var(--color-bg);
		min-width: 0;
	}

	:global([data-variant='split']) .hero-form {
		flex: 0 0 42%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 5rem 3.25rem;
		background: var(--color-surface-alt);
		border-left: 5px solid var(--color-accent-strong);
		min-width: 0;
	}

	@media (max-width: 47.9375rem) {
		:global([data-variant='split']) .hero-inner {
			flex-direction: column;
			min-height: auto;
		}

		:global([data-variant='split']) .hero-copy {
			padding: 3.25rem 1.5rem 2.5rem calc(5px + 1.5rem);
		}

		:global([data-variant='split']) .hero-form {
			flex: 0 0 auto;
			padding: 2.5rem 1.5rem 3.25rem;
		}
	}

	@media (max-width: 37.5rem) {
		.page {
			padding-left: calc(5px + 1rem);
			padding-right: 1rem;
		}

		.hero {
			padding: 3rem 0 2.5rem;
		}

		.features,
		.bottom-cta,
		.site-footer {
			padding-left: calc(5px + 1rem);
			padding-right: 1rem;
		}
	}

	/* Features + bottom CTA + footer — constant across all three variants */
	.features {
		width: 100%;
		max-width: 53.75rem;
		margin: 0 auto;
		padding: 4.5rem calc(5px + 1.5rem) 4.5rem 1.5rem;
		border-top: 1px solid color-mix(in srgb, var(--color-text-body) 12%, transparent);
	}

	.section-eyebrow {
		font-family: var(--font-display);
		font-size: clamp(1.625rem, 3.5vw, 2.5rem);
		margin-bottom: 2.5rem;
	}

	.features-grid {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 2.5rem;
	}

	@media (max-width: 47.9375rem) {
		.features-grid {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}
	}

	.feature-card {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.feat-num {
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		color: var(--color-accent-strong);
		font-family: var(--font-body);
	}

	.feat-title {
		font-family: var(--font-display);
		font-size: 1.1875rem;
		font-weight: 400;
		line-height: 1.25;
	}

	.feat-body {
		font-size: 0.875rem;
		line-height: 1.8;
		opacity: 0.85;
	}

	.bottom-cta {
		width: 100%;
		max-width: 53.75rem;
		margin: 0 auto;
		padding: 4.5rem calc(5px + 1.5rem) 6.25rem 1.5rem;
		border-top: 1px solid color-mix(in srgb, var(--color-text-body) 12%, transparent);
	}

	.bottom-cta-inner {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	@media (min-width: 48rem) {
		.bottom-cta-inner {
			flex-direction: row;
			align-items: flex-start;
			gap: 4rem;
		}

		.bottom-cta-copy {
			flex: 1;
		}

		.bottom-form {
			flex: 0 0 22.5rem;
		}
	}

	.bottom-eyebrow {
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.35em;
		text-transform: uppercase;
		color: var(--color-accent-strong);
		margin-bottom: 1rem;
	}

	.bottom-headline {
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		line-height: 1.1;
		margin-bottom: 1rem;
	}

	.bottom-sub {
		font-size: 0.9375rem;
		line-height: 1.75;
		opacity: 0.85;
	}

	.site-footer {
		width: 100%;
		max-width: 53.75rem;
		margin: 0 auto;
		padding: 1.5rem calc(5px + 1.5rem) 2.25rem 1.5rem;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.75rem;
		opacity: 0.6;
		border-top: 1px solid color-mix(in srgb, var(--color-text-body) 6%, transparent);
	}
</style>

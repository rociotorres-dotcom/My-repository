---
// Single landing page with a layout-variant switcher (Center Stage / Side by Side /
// Split), structurally identical to po-traction-engine.vercel.app/waitlist — same
// class structure, spacing, and breakpoints, with our own tokens (colors/fonts) and
// approved copy swapped in. Only the hero changes per variant; features, bottom CTA,
// and footer are constant, exactly as in the reference.
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import FeedbackWidget from '../components/FeedbackWidget.astro';
import VariantSwitcher from '../components/VariantSwitcher.astro';
import ImageCarousel from '../components/ImageCarousel.astro';

const year = new Date().getFullYear();
---

<BaseLayout>
	<nav class="sticky-nav">
		<div class="nav-logo">
			<!-- TODO P-114: typographic wordmark, provisional — replace with the real logo when Together Agency delivers it -->
			<span class="nav-logo-label">Gnome</span>
		</div>
		<div class="nav-switcher">
			<VariantSwitcher />
		</div>
		<a href="#waitlist-hero" class="nav-cta">Join the waitlist <span aria-hidden="true">→</span></a>
	</nav>

	<!--
		PO direction 2026-08-19: heavily blurred background photography behind rotating
		phrases, explicitly overriding the "no literal house icons" guardrail from
		context/gnome-warm-operator-design-system.md — the PO's call, made knowingly
		(four stock images, each with a house model/shape as the subject, not yet
		licensed). 2026-08-19 follow-up: same carousel reused (small, contained) in the
		two slots below that used to hold abstract SVG graphics — see ImageCarousel.astro.
	-->
	<ImageCarousel id="carousel-hero" variant="hero" />

	<div class="page">
		<!--
			PO direction 2026-08-20: "la imagen principal de la carpeta de Gerardo" as
			the hero's background — gerardo-hero-3.jpg is the same photo his
			LandingHero.tsx uses (HERO_IMAGE_SRC), reused here the same way he treats
			it: full-bleed photo, flat dark overlay (his is ink/30, ours a bit stronger
			since our text sits directly on it rather than in a separate card region),
			text on top. Hidden automatically in the Split variant — its two panels
			already paint their own opaque backgrounds over this.
		-->
		<main class="hero hero--photo">
			<div class="hero-inner">
				<div class="hero-copy">
					<p class="eyebrow">Early access</p>
					<h1 class="headline">Managed like an investment.<br />Easy as a companion.</h1>
					<p class="subtitle">
						Gnome turns every receipt, repair, and project into a record that protects your
						basis, backs your claims, and moves your value.<br />
						<em
							>Financial-grade tracking, delivered with the ease of a capable friend who happens
							to know houses and money.</em
						>
					</p>
				</div>

				<div class="hero-form" id="waitlist-hero">
					<p class="form-eyebrow">Join the waitlist</p>
					<p class="urgency-signal">Early access · By invitation, starting with our founder circle.</p>
					<WaitlistForm instanceId="hero" />
				</div>
			</div>
		</main>
	</div>

	<section class="features">
		<p class="section-eyebrow">What you'll get</p>
		<!--
			PO direction 2026-08-20: "el efecto de páginas una encima de otra" — Gerardo's
			LandingFeatures/FeaturePanel stack, replicated with plain vanilla JS/CSS
			(his version is React state written to a --cover custom property from a
			scroll listener; same mechanic here, no framework needed for it). Each
			panel is sticky at the top of the viewport; the next one scrolls up and
			covers the previous, which eases back, shrinks slightly and dims — see
			the .stack-panel rule and the scroll handler below.
		-->
		<div class="stack-container">
			<div class="stack-item" data-stack-index="0">
				<div class="stack-panel stack-panel--01">
					<div class="stack-panel-content">
						<div class="feat-heading">
							<svg class="feat-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
								<rect x="3" y="3" width="7" height="7" rx="1.5" />
								<rect x="14" y="3" width="7" height="7" rx="1.5" />
								<rect x="3" y="14" width="7" height="7" rx="1.5" />
								<rect x="14" y="14" width="7" height="7" rx="1.5" />
							</svg>
							<span class="feat-num">1</span>
						</div>
						<h3 class="feat-title">See it all, finally</h3>
						<p class="feat-body">
							Paint, equipment, documents, and cost basis — the whole home, legible for the
							first time.
						</p>
					</div>
					<div class="stack-panel-image" style="background-image: url('/card-01-see-it-all.jpg');"></div>
				</div>
			</div>

			<div class="stack-item" data-stack-index="1">
				<div class="stack-panel stack-panel--02">
					<div class="stack-panel-content">
						<div class="feat-heading">
							<svg class="feat-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
								<polyline points="3,17 9,11 13,15 21,6" />
								<polyline points="15,6 21,6 21,12" />
							</svg>
							<span class="feat-num">2</span>
						</div>
						<h3 class="feat-title">See it coming</h3>
						<p class="feat-body">
							Maintenance flagged before it's a liability. Improvements weighed by what they'll
							actually return.
						</p>
					</div>
					<div class="stack-panel-image" style="background-image: url('/card-02-see-it-coming.jpg');"></div>
				</div>
			</div>

			<div class="stack-item" data-stack-index="2">
				<div class="stack-panel stack-panel--03">
					<div class="stack-panel-content">
						<div class="feat-heading">
							<svg class="feat-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
								<rect x="4" y="4" width="16" height="4.5" rx="1.25" />
								<rect x="4" y="10.25" width="16" height="4.5" rx="1.25" />
								<rect x="4" y="16.5" width="16" height="4.5" rx="1.25" />
							</svg>
							<span class="feat-num">3</span>
						</div>
						<h3 class="feat-title">Built to be inherited</h3>
						<p class="feat-body">
							An insurance-ready report, a buyer-ready history, a record a new contractor — or
							an heir — can pick up without starting blind.
						</p>
					</div>
					<div class="stack-panel-image" style="background-image: url('/card-03-inherited.png');"></div>
				</div>
			</div>
		</div>
	</section>

	<section class="bottom-cta" id="waitlist">
		<div class="bottom-cta-inner">
			<div class="bottom-cta-copy">
				<p class="bottom-eyebrow">Secure your spot</p>
				<h2 class="bottom-headline">Command, not chores.</h2>
				<p class="bottom-sub">Reserve your spot. Gnome does the watching; every decision stays yours.</p>

				<ImageCarousel id="carousel-bottom" variant="bottom" showPhrase={false} />
			</div>
			<div class="bottom-form" id="waitlist-bottom">
				<WaitlistForm instanceId="bottom" />
			</div>
		</div>
	</section>

	<!--
		PO direction 2026-08-20: full-bleed edge to edge (was contained/rounded),
		shorter/wider proportions, tagline + links relocated down to sit with the
		fine print per her annotated screenshot — the big "Gnome" wordmark and the
		fine print line stay where they were. "Login" dropped per her earlier
		note (there's no authenticated app yet); Privacy/Terms are placeholders
		(TODO: real routes — see the "NO PUBLIC LAUNCH UNTIL" checklist in
		README.md, legal pages are already listed there as a launch blocker).
	-->
	<footer class="site-footer-banner">
		<p class="footer-tagline">Managing a home that<br />knows its own worth</p>
		<p class="footer-wordmark" aria-hidden="true">Gnome</p>
		<div class="footer-banner-bottom">
			<div class="footer-links">
				<a href="mailto:info@gnome.com">info@gnome.com</a>
				<a href="#">Privacy Policy</a>
				<a href="#">Terms of Service</a>
			</div>
		</div>
		<p class="footer-fineprint">Gnome · {year} · TractionLab · Designli</p>
	</footer>

	<FeedbackWidget />
</BaseLayout>

<script>
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('.img-carousel').forEach((carousel) => {
		const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.carousel-slide'));
		const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.carousel-dot'));
		let current = 0;
		let timer: ReturnType<typeof setInterval> | undefined;

		function show(index: number) {
			current = (index + slides.length) % slides.length;
			slides.forEach((slide, i) => slide.classList.toggle('is-active', i === current));
			dots.forEach((dot, i) => dot.classList.toggle('is-active', i === current));
		}

		function startAutoplay() {
			stopAutoplay();
			timer = setInterval(() => show(current + 1), 5000);
		}

		function stopAutoplay() {
			if (timer) clearInterval(timer);
		}

		dots.forEach((dot) => {
			dot.addEventListener('click', () => {
				show(Number(dot.dataset.index));
				startAutoplay();
			});
		});

		if (!prefersReducedMotion) {
			startAutoplay();
			carousel.addEventListener('mouseenter', stopAutoplay);
			carousel.addEventListener('mouseleave', startAutoplay);
		}
	});

	// Stacking-panel scroll effect, adapted from Gerardo's usePanelCover (React
	// state → CSS var, in the homeiq-platform prototype). Same idea in plain
	// JS: each panel's "how covered am I" (0–1) is written straight to the node
	// as --cover, driven only by scroll position — no rAF, no framework.
	if (!prefersReducedMotion) {
		const stackContainer = document.querySelector<HTMLElement>('.stack-container');
		if (stackContainer) {
			const stackItems = Array.from(stackContainer.querySelectorAll<HTMLElement>('.stack-item'));

			const updateStack = () => {
				const containerTop = stackContainer.getBoundingClientRect().top + window.scrollY;
				stackItems.forEach((item, index) => {
					const panel = item.querySelector<HTMLElement>('.stack-panel');
					if (!panel) return;
					const step = item.offsetHeight;
					const covered = (window.scrollY - (containerTop + index * step)) / step;
					panel.style.setProperty('--cover', String(Math.min(1, Math.max(0, covered))));
				});
			};

			updateStack();
			window.addEventListener('scroll', updateStack, { passive: true });
			window.addEventListener('resize', updateStack);
		}
	}
</script>

<style>
	/* Left accent bar — fixed, full height. Matches the reference's slim brand bar. */
	:global(body)::before {
		content: '';
		position: fixed;
		top: 0;
		left: 0;
		width: 5px;
		height: 100vh;
		background: var(--color-accent-strong);
		z-index: 100;
	}

	.sticky-nav {
		position: fixed;
		top: 0;
		left: 5px;
		right: 0;
		height: 3.25rem;
		z-index: 200;
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1rem;
		padding: 0 1.25rem;
		background: var(--color-bg);
		border-bottom: 1px solid var(--wo-border);
	}

	.nav-logo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav-logo-label {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1.1rem;
	}

	.nav-switcher {
		display: flex;
		justify-content: center;
	}

	/*
		Secondary style on purpose — "never two orange buttons in one view" competing
		for attention. The waitlist forms' submit buttons are the one true primary
		action; this nav link just anchors down to them.
	*/
	.nav-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		background: transparent;
		border: 1.5px solid var(--wo-border);
		color: var(--color-text-body);
		text-decoration: none;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: calc(0.55rem - 1.5px) calc(0.9rem - 1.5px);
		border-radius: 5px;
		white-space: nowrap;
		transition: border-color 0.2s, color 0.2s;
	}

	.nav-cta:hover {
		border-color: var(--color-accent-strong);
		color: var(--wo-accent-ink);
	}

	@media (max-width: 37.5rem) {
		.sticky-nav {
			grid-template-columns: auto 1fr;
		}

		/*
			Bug fix (PO feedback 2026-08-20): VariantSwitcher hides its own inner
			markup on mobile, but this wrapper div was still a grid cell — with
			only 2 columns defined here but 3 grid items, .nav-cta wrapped onto a
			second row and overflowed below the nav's fixed height. Hiding the
			wrapper itself removes it from the grid so logo + cta share the 2
			columns as intended.
		*/
		.nav-switcher {
			display: none;
		}

		.nav-cta {
			padding: 0.45rem 0.7rem;
		}
	}

	/* Carousel styling lives in ImageCarousel.astro's own <style> block — Astro scopes
	   styles per-component, so rules for markup that component renders have to live
	   there, not here (this was the bug: these rules never matched anything before). */

	.page {
		padding-top: 3.25rem;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-left: calc(5px + 1.5rem);
		padding-right: 1.5rem;
	}

	.hero {
		flex: 1;
		width: 100%;
		max-width: 53.75rem;
		display: flex;
		align-items: center;
		padding: 4.5rem 0 3.75rem;
	}

	/* Gerardo's hero photo, reused as our hero's background — see the comment
	   above the markup. Split hides it naturally (its panels paint over it).
	   max-width is wider than the plain hero — PO feedback 2026-08-20: the
	   photo card read as small and overly centered inside a lot of empty
	   background at wide viewports. */
	.hero--photo {
		position: relative;
		isolation: isolate;
		max-width: 72rem;
		border-radius: var(--radius-shell);
		background-image: url('/gerardo-hero-3.jpg');
		background-size: cover;
		background-position: center;
		padding-left: 2.5rem;
		padding-right: 2.5rem;
	}

	.hero--photo::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: rgba(22, 22, 26, 0.55);
	}

	.hero--photo .hero-inner {
		position: relative;
		z-index: 1;
	}

	.hero--photo .headline,
	.hero--photo .subtitle {
		color: var(--wo-on-dark);
	}

	.hero--photo .eyebrow,
	.hero--photo .form-eyebrow,
	.hero--photo .urgency-signal,
	.hero--photo .subtitle em {
		color: var(--wo-accent-on-dark);
	}

	.hero--photo .urgency-signal {
		background: rgba(22, 22, 26, 0.35);
		border-color: rgba(224, 169, 127, 0.4);
	}

	/*
		Bug fix (PO feedback 2026-08-20): WaitlistForm is a separate component with
		its own fixed label colors (muted grey, tuned for a cream background) — it
		has no idea it's now sometimes sitting on a dark photo. :global() reaches
		into it from here since Astro's scoping won't otherwise cross the
		component boundary. Labels go to on-dark cream (near-white, per PO's own
		options); the required asterisk and "optional" chip move from accent-ink
		(illegible on a photo) to accent-on-dark.
	*/
	:global(.hero--photo .waitlist-form__field > span) {
		color: var(--wo-on-dark);
	}

	:global(.hero--photo .waitlist-form__req),
	:global(.hero--photo .waitlist-form__optional) {
		color: var(--wo-accent-on-dark);
	}

	:global(.hero--photo .waitlist-form__optional) {
		background: rgba(224, 169, 127, 0.16);
		border-color: rgba(224, 169, 127, 0.4);
	}

	@media (max-width: 37.5rem) {
		.hero--photo {
			padding-left: 1.25rem;
			padding-right: 1.25rem;
		}
	}

	.hero-inner {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	@media (min-width: 48rem) {
		.hero-inner {
			flex-direction: row;
			align-items: flex-start;
			gap: 4rem;
		}

		.hero-copy {
			flex: 1;
			min-width: 0;
		}

		.hero-form {
			flex: 0 0 21.25rem;
			padding-top: 0.5rem;
		}
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--wo-accent-ink);
		margin-bottom: 1.75rem;
	}

	.headline {
		font-size: clamp(2.25rem, 6vw, 4.5rem);
		margin-bottom: 2.25rem;
	}

	.subtitle {
		font-family: var(--font-body);
		font-size: clamp(1.0625rem, 2vw, 1.1875rem);
		line-height: 1.65;
		color: var(--wo-text-soft);
		margin-bottom: 1.5rem;
	}

	.subtitle em {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--wo-accent-ink);
	}

	.form-eyebrow {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--wo-accent-ink);
		margin-bottom: 0.5rem;
	}

	.urgency-signal {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.05em;
		color: var(--wo-accent-ink);
		background: color-mix(in srgb, var(--color-accent-strong) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-accent-strong) 35%, transparent);
		border-radius: 3px;
		padding: 0.25rem 0.6rem;
		display: inline-block;
		margin-bottom: 1.25rem;
	}

	/* Center Stage */
	:global([data-variant='center-stage']) .page {
		align-items: center;
	}

	:global([data-variant='center-stage']) .hero {
		max-width: 40rem;
		text-align: center;
	}

	:global([data-variant='center-stage']) .hero-inner {
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
	}

	:global([data-variant='center-stage']) .headline {
		font-size: clamp(2.25rem, 5vw, 4rem);
	}

	:global([data-variant='center-stage']) .hero-form {
		width: 100%;
		max-width: 30rem;
		flex: 0 0 auto;
		padding-top: 0;
		text-align: left;
	}

	/* Split */
	:global([data-variant='split']) .page {
		flex-direction: row;
		align-items: stretch;
		max-width: none;
		padding: 0;
		min-height: 100vh;
	}

	:global([data-variant='split']) .hero {
		max-width: none;
		width: 100%;
		padding: 0;
		display: flex;
		align-items: stretch;
	}

	/* Split already goes full-bleed edge to edge; the hero-photo shell rounding
	   (and its now-redundant overlay, fully hidden anyway) shouldn't apply here. */
	:global([data-variant='split']) .hero--photo {
		border-radius: 0;
	}

	/*
		Bug fix (PO feedback 2026-08-20): .hero--photo's on-dark text colors were
		leaking into Split, where hero-copy/hero-form paint their own opaque
		light backgrounds over the photo — cream text on a cream panel was
		reading as invisible. Restore normal ink-based colors here, with the
		headline in strong clay orange per the PO's request for more punch in
		this variant specifically.
	*/
	:global([data-variant='split']) .hero--photo .headline {
		color: var(--color-accent-strong);
	}

	:global([data-variant='split']) .hero--photo .subtitle {
		color: var(--wo-text-soft);
	}

	:global([data-variant='split']) .hero--photo .eyebrow,
	:global([data-variant='split']) .hero--photo .form-eyebrow,
	:global([data-variant='split']) .hero--photo .urgency-signal,
	:global([data-variant='split']) .hero--photo .subtitle em {
		color: var(--wo-accent-ink);
	}

	:global([data-variant='split']) .hero--photo .urgency-signal {
		background: color-mix(in srgb, var(--color-accent-strong) 10%, transparent);
		border-color: color-mix(in srgb, var(--color-accent-strong) 35%, transparent);
	}

	/* Split's hero-form panel is its own opaque light surface — the on-dark
	   WaitlistForm label fix above is for the photo instance only. */
	:global([data-variant='split']) .hero--photo .waitlist-form__field > span {
		color: var(--wo-muted);
	}

	:global([data-variant='split']) .hero--photo .waitlist-form__req,
	:global([data-variant='split']) .hero--photo .waitlist-form__optional {
		color: var(--wo-accent-ink);
	}

	:global([data-variant='split']) .hero--photo .waitlist-form__optional {
		background: color-mix(in srgb, var(--color-accent-strong) 12%, transparent);
		border-color: color-mix(in srgb, var(--color-accent-strong) 35%, transparent);
	}

	:global([data-variant='split']) .hero-inner {
		flex-direction: row;
		align-items: stretch;
		gap: 0;
		width: 100%;
		min-height: calc(100vh - 3.25rem);
	}

	:global([data-variant='split']) .hero-copy {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 5rem 3.75rem 5rem calc(5px + 3.75rem);
		background: var(--color-bg);
		min-width: 0;
	}

	:global([data-variant='split']) .hero-form {
		flex: 0 0 42%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 5rem 3.25rem;
		background: var(--color-surface-alt);
		border-left: 5px solid var(--color-accent-strong);
		min-width: 0;
	}

	@media (max-width: 47.9375rem) {
		:global([data-variant='split']) .hero-inner {
			flex-direction: column;
			min-height: auto;
		}

		:global([data-variant='split']) .hero-copy {
			padding: 3.25rem 1.5rem 2.5rem calc(5px + 1.5rem);
		}

		:global([data-variant='split']) .hero-form {
			flex: 0 0 auto;
			padding: 2.5rem 1.5rem 3.25rem;
		}
	}

	/* Tighter rhythm on mobile — PO feedback 2026-08-20: sections felt too spaced
	   out/empty on a small screen. */
	@media (max-width: 37.5rem) {
		.page {
			padding-left: calc(5px + 1rem);
			padding-right: 1rem;
		}

		.hero {
			padding: 2rem 0 1.75rem;
		}

		.hero-inner {
			gap: 2rem;
		}


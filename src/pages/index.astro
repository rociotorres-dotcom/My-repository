---
// Single landing page with a layout-variant switcher (Center Stage / Side by Side /
// Split), structurally identical to po-traction-engine.vercel.app/waitlist — same
// class structure, spacing, and breakpoints, with our own tokens (colors/fonts) and
// approved copy swapped in. Only the hero changes per variant; features, bottom CTA,
// and footer are constant, exactly as in the reference.
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import FeedbackWidget from '../components/FeedbackWidget.astro';
import VariantSwitcher from '../components/VariantSwitcher.astro';
import ImageCarousel from '../components/ImageCarousel.astro';

const year = new Date().getFullYear();
---

<BaseLayout>
	<nav class="sticky-nav">
		<div class="nav-logo">
			<!-- TODO P-114: typographic wordmark, provisional — replace with the real logo when Together Agency delivers it -->
			<span class="nav-logo-label">Gnome</span>
		</div>
		<div class="nav-switcher">
			<VariantSwitcher />
		</div>
		<a href="#waitlist-hero" class="nav-cta">Join the waitlist <span aria-hidden="true">→</span></a>
	</nav>

	<!--
		PO direction 2026-08-19: heavily blurred background photography behind rotating
		phrases, explicitly overriding the "no literal house icons" guardrail from
		context/gnome-warm-operator-design-system.md — the PO's call, made knowingly
		(four stock images, each with a house model/shape as the subject, not yet
		licensed). 2026-08-19 follow-up: same carousel reused (small, contained) in the
		two slots below that used to hold abstract SVG graphics — see ImageCarousel.astro.
	-->
	<ImageCarousel id="carousel-hero" variant="hero" />

	<div class="page">
		<main class="hero">
			<div class="hero-inner">
				<div class="hero-copy">
					<p class="eyebrow">Early access</p>
					<h1 class="headline">Managed like an investment.<br />Easy as a companion.</h1>
					<p class="subtitle">
						Gnome turns every receipt, repair, and project into a record that protects your
						basis, backs your claims, and moves your value.<br />
						<em
							>Financial-grade tracking, delivered with the ease of a capable friend who happens
							to know houses and money.</em
						>
					</p>
				</div>

				<div class="hero-form" id="waitlist-hero">
					<p class="form-eyebrow">Join the waitlist</p>
					<p class="urgency-signal">Early access · By invitation, starting with our founder circle.</p>
					<WaitlistForm instanceId="hero" />
				</div>
			</div>
		</main>
	</div>

	<section class="visual-band">
		<ImageCarousel id="carousel-band" variant="band" />
	</section>

	<section class="features">
		<p class="section-eyebrow">What you'll get</p>
		<div class="features-grid">
			<div class="feature-card">
				<svg class="feat-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
					<rect x="3" y="3" width="7" height="7" rx="1.5" />
					<rect x="14" y="3" width="7" height="7" rx="1.5" />
					<rect x="3" y="14" width="7" height="7" rx="1.5" />
					<rect x="14" y="14" width="7" height="7" rx="1.5" />
				</svg>
				<span class="feat-num">01</span>
				<h3 class="feat-title">See it all, finally</h3>
				<p class="feat-body">
					Paint, equipment, documents, and cost basis — the whole home, legible for the first
					time.
				</p>
			</div>

			<div class="feature-card">
				<svg class="feat-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
					<polyline points="3,17 9,11 13,15 21,6" />
					<polyline points="15,6 21,6 21,12" />
				</svg>
				<span class="feat-num">02</span>
				<h3 class="feat-title">See it coming</h3>
				<p class="feat-body">
					Maintenance flagged before it's a liability. Improvements weighed by what they'll
					actually return.
				</p>
			</div>

			<div class="feature-card">
				<svg class="feat-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
					<rect x="4" y="4" width="16" height="4.5" rx="1.25" />
					<rect x="4" y="10.25" width="16" height="4.5" rx="1.25" />
					<rect x="4" y="16.5" width="16" height="4.5" rx="1.25" />
				</svg>
				<span class="feat-num">03</span>
				<h3 class="feat-title">Built to be inherited</h3>
				<p class="feat-body">
					An insurance-ready report, a buyer-ready history, a record a new contractor — or an
					heir — can pick up without starting blind.
				</p>
			</div>
		</div>
	</section>

	<section class="bottom-cta" id="waitlist">
		<div class="bottom-cta-inner">
			<div class="bottom-cta-copy">
				<p class="bottom-eyebrow">Secure your spot</p>
				<h2 class="bottom-headline">Command, not chores.</h2>
				<p class="bottom-sub">Reserve your spot. Gnome does the watching; every decision stays yours.</p>

				<ImageCarousel id="carousel-bottom" variant="bottom" showPhrase={false} />
			</div>
			<div class="bottom-form" id="waitlist-bottom">
				<WaitlistForm instanceId="bottom" />
			</div>
		</div>
	</section>

	<footer class="site-footer">
		<!-- TODO P-114: same provisional wordmark as the nav -->
		<span>Gnome · {year}</span>
		<span class="sep">·</span>
		<span>TractionLab · Designli</span>
	</footer>

	<FeedbackWidget />
</BaseLayout>

<script>
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('.img-carousel').forEach((carousel) => {
		const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.carousel-slide'));
		const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.carousel-dot'));
		let current = 0;
		let timer: ReturnType<typeof setInterval> | undefined;

		function show(index: number) {
			current = (index + slides.length) % slides.length;
			slides.forEach((slide, i) => slide.classList.toggle('is-active', i === current));
			dots.forEach((dot, i) => dot.classList.toggle('is-active', i === current));
		}

		function startAutoplay() {
			stopAutoplay();
			timer = setInterval(() => show(current + 1), 5000);
		}

		function stopAutoplay() {
			if (timer) clearInterval(timer);
		}

		dots.forEach((dot) => {
			dot.addEventListener('click', () => {
				show(Number(dot.dataset.index));
				startAutoplay();
			});
		});

		if (!prefersReducedMotion) {
			startAutoplay();
			carousel.addEventListener('mouseenter', stopAutoplay);
			carousel.addEventListener('mouseleave', startAutoplay);
		}
	});
</script>

<style>
	/* Left accent bar — fixed, full height. Matches the reference's slim brand bar. */
	:global(body)::before {
		content: '';
		position: fixed;
		top: 0;
		left: 0;
		width: 5px;
		height: 100vh;
		background: var(--color-accent-strong);
		z-index: 100;
	}

	.sticky-nav {
		position: fixed;
		top: 0;
		left: 5px;
		right: 0;
		height: 3.25rem;
		z-index: 200;
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1rem;
		padding: 0 1.25rem;
		background: var(--color-bg);
		border-bottom: 1px solid var(--wo-border);
	}

	.nav-logo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav-logo-label {
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1.1rem;
	}

	.nav-switcher {
		display: flex;
		justify-content: center;
	}

	/*
		Secondary style on purpose — "never two orange buttons in one view" competing
		for attention. The waitlist forms' submit buttons are the one true primary
		action; this nav link just anchors down to them.
	*/
	.nav-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		background: transparent;
		border: 1.5px solid var(--wo-border);
		color: var(--color-text-body);
		text-decoration: none;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: calc(0.55rem - 1.5px) calc(0.9rem - 1.5px);
		border-radius: 5px;
		white-space: nowrap;
		transition: border-color 0.2s, color 0.2s;
	}

	.nav-cta:hover {
		border-color: var(--color-accent-strong);
		color: var(--wo-accent-ink);
	}

	@media (max-width: 37.5rem) {
		.sticky-nav {
			grid-template-columns: auto 1fr;
		}

		.nav-cta {
			padding: 0.45rem 0.7rem;
		}
	}

	/* Carousel styling lives in ImageCarousel.astro's own <style> block — Astro scopes
	   styles per-component, so rules for markup that component renders have to live
	   there, not here (this was the bug: these rules never matched anything before). */

	.page {
		padding-top: 3.25rem;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-left: calc(5px + 1.5rem);
		padding-right: 1.5rem;
	}

	.hero {
		flex: 1;
		width: 100%;
		max-width: 53.75rem;
		display: flex;
		align-items: center;
		padding: 4.5rem 0 3.75rem;
	}

	.hero-inner {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	@media (min-width: 48rem) {
		.hero-inner {
			flex-direction: row;
			align-items: flex-start;
			gap: 4rem;
		}

		.hero-copy {
			flex: 1;
			min-width: 0;
		}

		.hero-form {
			flex: 0 0 21.25rem;
			padding-top: 0.5rem;
		}
	}

	.eyebrow {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--wo-accent-ink);
		margin-bottom: 1.75rem;
	}

	.headline {
		font-size: clamp(2.25rem, 6vw, 4.5rem);
		margin-bottom: 2.25rem;
	}

	.subtitle {
		font-family: var(--font-body);
		font-size: clamp(1.0625rem, 2vw, 1.1875rem);
		line-height: 1.65;
		color: var(--wo-text-soft);
		margin-bottom: 1.5rem;
	}

	.subtitle em {
		font-family: var(--font-display);
		font-style: italic;
		color: var(--wo-accent-ink);
	}

	.form-eyebrow {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--wo-accent-ink);
		margin-bottom: 0.5rem;
	}

	.urgency-signal {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.05em;
		color: var(--wo-accent-ink);
		background: color-mix(in srgb, var(--color-accent-strong) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-accent-strong) 35%, transparent);
		border-radius: 3px;
		padding: 0.25rem 0.6rem;
		display: inline-block;
		margin-bottom: 1.25rem;
	}

	/* Center Stage */
	:global([data-variant='center-stage']) .page {
		align-items: center;
	}

	:global([data-variant='center-stage']) .hero {
		max-width: 40rem;
		text-align: center;
	}

	:global([data-variant='center-stage']) .hero-inner {
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
	}

	:global([data-variant='center-stage']) .headline {
		font-size: clamp(2.25rem, 5vw, 4rem);
	}

	:global([data-variant='center-stage']) .hero-form {
		width: 100%;
		max-width: 30rem;
		flex: 0 0 auto;
		padding-top: 0;
		text-align: left;
	}

	/* Split */
	:global([data-variant='split']) .page {
		flex-direction: row;
		align-items: stretch;
		max-width: none;
		padding: 0;
		min-height: 100vh;
	}

	:global([data-variant='split']) .hero {
		max-width: none;
		width: 100%;
		padding: 0;
		display: flex;
		align-items: stretch;
	}

	:global([data-variant='split']) .hero-inner {
		flex-direction: row;
		align-items: stretch;
		gap: 0;
		width: 100%;
		min-height: calc(100vh - 3.25rem);
	}

	:global([data-variant='split']) .hero-copy {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 5rem 3.75rem 5rem calc(5px + 3.75rem);
		background: var(--color-bg);
		min-width: 0;
	}

	:global([data-variant='split']) .hero-form {
		flex: 0 0 42%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 5rem 3.25rem;
		background: var(--color-surface-alt);
		border-left: 5px solid var(--color-accent-strong);
		min-width: 0;
	}

	@media (max-width: 47.9375rem) {
		:global([data-variant='split']) .hero-inner {
			flex-direction: column;
			min-height: auto;
		}

		:global([data-variant='split']) .hero-copy {
			padding: 3.25rem 1.5rem 2.5rem calc(5px + 1.5rem);
		}

		:global([data-variant='split']) .hero-form {
			flex: 0 0 auto;
			padding: 2.5rem 1.5rem 3.25rem;
		}
	}

	@media (max-width: 37.5rem) {
		.page {
			padding-left: calc(5px + 1rem);
			padding-right: 1rem;
		}

		.hero {
			padding: 3rem 0 2.5rem;
		}

		.features,
		.bottom-cta,
		.site-footer {
			padding-left: calc(5px + 1rem);
			padding-right: 1rem;
		}
	}

	/* Visual band — constant across all three variants, same as features/bottom-cta.
	   Holds the ImageCarousel "band" instance; sizing/shape lives on .img-carousel--band. */
	.visual-band {
		width: 100%;
		max-width: 53.75rem;
		margin: 0 auto;
		padding: 0 calc(5px + 1.5rem) 0 1.5rem;
	}

	@media (max-width: 37.5rem) {
		.visual-band {
			padding-left: calc(5px + 1rem);
			padding-right: 1rem;
		}
	}

	/* Features + bottom CTA + footer — constant across all three variants */
	.features {
		width: 100%;
		max-width: 53.75rem;
		margin: 0 auto;
		padding: 4.5rem calc(5px + 1.5rem) 4.5rem 1.5rem;
		border-top: 1px solid color-mix(in srgb, var(--color-text-body) 12%, transparent);
	}

	.section-eyebrow {
		font-family: var(--font-body);
		font-weight: 700;
		letter-spacing: -0.03em;
		font-size: clamp(1.625rem, 3.5vw, 2.1875rem);
		margin-bottom: 2.5rem;
	}

	.features-grid {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 2.5rem;
	}

	@media (max-width: 47.9375rem) {
		.features-grid {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}
	}

	.feature-card {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	/* Abstract, monoline marks — not literal house icons, not illustrations of the
	   product UI. Same restraint as the visual-band graphic above. */
	.feat-icon {
		width: 1.5rem;
		height: 1.5rem;
		stroke: var(--color-text-body);
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		margin-bottom: 0.25rem;
	}

	.feat-num {
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		color: var(--wo-accent-ink);
		font-family: var(--font-mono);
	}

	.feat-title {
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.25;
	}

	.feat-body {
		font-size: 0.875rem;
		line-height: 1.8;
		opacity: 0.85;
	}

	.bottom-cta {
		width: 100%;
		max-width: 53.75rem;
		margin: 0 auto;
		padding: 4.5rem calc(5px + 1.5rem) 6.25rem 1.5rem;
		border-top: 1px solid color-mix(in srgb, var(--color-text-body) 12%, transparent);
	}

	.bottom-cta-inner {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	@media (min-width: 48rem) {
		.bottom-cta-inner {
			flex-direction: row;
			align-items: flex-start;
			gap: 4rem;
		}

		.bottom-cta-copy {
			flex: 1;
		}

		.bottom-form {
			flex: 0 0 22.5rem;
		}
	}

	.bottom-eyebrow {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--wo-accent-ink);
		margin-bottom: 1rem;
	}

	.bottom-headline {
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		margin-bottom: 1rem;
	}

	.bottom-sub {
		font-family: var(--font-body);
		font-size: 0.9375rem;
		line-height: 1.75;
		color: var(--wo-text-soft);
		margin-bottom: 2rem;
	}

	.site-footer {
		width: 100%;
		max-width: 53.75rem;
		margin: 0 auto;
		padding: 1.5rem calc(5px + 1.5rem) 2.25rem 1.5rem;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.75rem;
		opacity: 0.6;
		border-top: 1px solid color-mix(in srgb, var(--color-text-body) 6%, transparent);
	}
</style>
